# ---- 基础设施 ----
DATABASE_URL=postgres://agentic:agentic@localhost:5432/agentic_news
REDIS_URL=redis://localhost:6379

# ---- API ----
API_PORT=3001
JWT_SECRET=change-me-in-production
# Web 所在源，用于 CORS
WEB_ORIGIN=http://localhost:3000

# ---- Web ----
NEXT_PUBLIC_API_URL=http://localhost:3001

# ---- LLM / Embedding（待定项，见 docs/architecture.md）----
# provider 取值：local（默认，无需 Key，用抽取式摘要 + 本地确定性向量，管线可跑通）
#               openai（填 Key 后启用真实模型）
LLM_PROVIDER=local
LLM_MODEL=gpt-4o-mini
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
OPENAI_API_KEY=

# ---- X（Twitter）采集 ----
# 应用级 Bearer Token；未配置时 XAdapter 自动停用，其余管线不受影响
X_BEARER_TOKEN=

# ---- Collector ----
COLLECTOR_TICK_MS=60000
